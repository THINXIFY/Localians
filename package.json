{
  "name": "localians-web",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev -p 3001",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc -p tsconfig.app.json --noEmit && tsc --noEmit",
    "db:start": "tsx scripts/local-postgres.ts",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:generate": "prisma generate",
    "db:studio": "prisma studio",
    "postinstall": "prisma generate",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "tunnel:build": "node scripts/build-tunnel.mjs",
    "gateway:dev": "tsx tunnel/gateway/main.ts",
    "cli": "tsx tunnel/cli/main.ts",
    "tunnel:certs": "node scripts/dev-certs.mjs",
    "gateway:start": "node --env-file=.env tunnel/gateway/dist/gateway.js",
    "start:prod": "next start --port 4000 --hostname 127.0.0.1",
    "check:prod-env": "node scripts/check-production-env.mjs",
    "cli:release": "node scripts/build-tunnel.mjs --release",
    "vscode:build": "npm --prefix extensions/vscode run build",
    "vscode:typecheck": "npm --prefix extensions/vscode run typecheck",
    "vscode:package": "npm --prefix extensions/vscode run package",
    "vscode:test": "node scripts/vscode-host-test.mjs",
    "vscode:draft-release": "node scripts/draft-vsix-release.mjs",
    "vscode:verify-release": "node scripts/verify-vsix-release.mjs",
    "admin:create": "tsx scripts/create-admin.ts"
  },
  "dependencies": {
    "@hookform/resolvers": "^5.9.2",
    "@noble/hashes": "^2.4.0",
    "@prisma/adapter-pg": "^7.10.1",
    "@prisma/client": "^7.10.1",
    "better-auth": "^1.7.12",
    "clsx": "^2.1.1",
    "jose": "^6.2.13",
    "lucide-react": "^1.60.0",
    "motion": "^14.4.0",
    "next": "^16.4.2",
    "pg": "^8.23.1",
    "qrcode-generator": "^1.5.2",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-hook-form": "^7.90.0",
    "server-only": "^0.0.1",
    "sharp": "^0.35.5",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^26.6.5",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/ws": "^8.18.2",
    "@vscode/test-electron": "^2.5.2",
    "embedded-postgres": "^17.10.0-beta.17",
    "esbuild": "^0.28.2",
    "eslint": "^9.39.5",
    "eslint-config-next": "^16.4.2",
    "jsqr": "^1.4.0",
    "postcss": "^8.5.31",
    "prisma": "^7.10.1",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "vite": "^8.3.4",
    "vitest": "^5.0.5",
    "ws": "^8.22.0"
  },
  "allowScripts": {
    "@embedded-postgres/windows-x64@17.10.0-beta.17": true,
    "@prisma/engines@7.10.1": true,
    "esbuild@0.28.2": true,
    "prisma@7.10.1": true,
    "unrs-resolver@1.12.2": true
  }
}
