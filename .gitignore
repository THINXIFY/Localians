# ---------------------------------------------------------------- dependencies
node_modules/
.pnp
.pnp.*
.yarn/*

# ---------------------------------------------------------------- builds & generated
.next/
out/
build/
dist/
tunnel/cli/dist/
tunnel/gateway/dist/
examples/*/.next/
examples/*/dist/
*.tsbuildinfo
next-env.d.ts
# Prisma client is generated by `prisma generate` (runs on npm install)
src/generated/

# ---------------------------------------------------------------- environment & secrets
# Real environment files never leave the machine; .env.example (placeholders) is committed.
.env
.env.*
!.env.example
!.env.production.example
*.pem
*.key
*.crt
*.p12
*.pfx
*.jks
credentials.json
secrets/

# Local development data: embedded PostgreSQL, generated TLS CA/certs, email outbox
.localians-dev/

# ---------------------------------------------------------------- databases
*.db
*.sqlite
*.sqlite3
pgdata/

# ---------------------------------------------------------------- tests & tooling output
test-results/
playwright-report/
blob-report/
playwright/.cache/
coverage/
.vitest-cache/
node_modules/.vitest-cache/

# ---------------------------------------------------------------- logs, caches, temp
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
.cache/
.turbo/
.vercel/
.eslintcache
tmp/
temp/
*.tmp

# ---------------------------------------------------------------- OS & editors
.DS_Store
Thumbs.db
desktop.ini
.idea/
.vscode/*
!.vscode/extensions.json
*.swp
.vscode-test/
