{
  "name": "localians",
  "displayName": "Localians — Share Localhost",
  "description": "Share the app running on your computer with a secure HTTPS preview link — public or password protected. Sign in once, pick your app, click Share.",
  "version": "0.2.0",
  "publisher": "thinxify",
  "license": "SEE LICENSE IN LICENSE.md",
  "pricing": "Free",
  "private": true,
  "icon": "media/icon.png",
  "galleryBanner": {
    "color": "#070907",
    "theme": "dark"
  },
  "homepage": "https://localians.com",
  "repository": {
    "type": "git",
    "url": "https://github.com/THINXIFY/Localians.git",
    "directory": "extensions/vscode"
  },
  "bugs": {
    "url": "https://github.com/THINXIFY/Localians/issues"
  },
  "engines": {
    "vscode": "^1.90.0"
  },
  "categories": [
    "Other",
    "Testing"
  ],
  "keywords": [
    "localhost",
    "tunnel",
    "share",
    "preview",
    "https",
    "ngrok",
    "dev server",
    "localians"
  ],
  "main": "./dist/extension.js",
  "extensionKind": [
    "workspace"
  ],
  "activationEvents": [
    "onStartupFinished"
  ],
  "capabilities": {
    "virtualWorkspaces": false,
    "untrustedWorkspaces": {
      "supported": "limited",
      "description": "Sharing is turned off until you trust the workspace."
    }
  },
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "localians",
          "title": "Localians",
          "icon": "media/activity.svg"
        }
      ]
    },
    "views": {
      "localians": [
        {
          "type": "webview",
          "id": "localians.panel",
          "name": "Localians",
          "icon": "media/activity.svg",
          "contextualTitle": "Localians"
        }
      ]
    },
    "commands": [
      {
        "command": "localians.focus",
        "title": "Open Localians",
        "category": "Localians",
        "icon": "$(broadcast)"
      },
      {
        "command": "localians.share",
        "title": "Share App",
        "category": "Localians",
        "icon": "$(broadcast)"
      },
      {
        "command": "localians.stop",
        "title": "Stop Sharing",
        "category": "Localians",
        "icon": "$(debug-stop)"
      },
      {
        "command": "localians.copyLink",
        "title": "Copy Preview Link",
        "category": "Localians",
        "icon": "$(copy)"
      },
      {
        "command": "localians.openPreview",
        "title": "Open Preview",
        "category": "Localians",
        "icon": "$(link-external)"
      },
      {
        "command": "localians.protect",
        "title": "Set Preview Password",
        "category": "Localians",
        "icon": "$(lock)"
      },
      {
        "command": "localians.reconnect",
        "title": "Share Again",
        "category": "Localians",
        "icon": "$(debug-restart)"
      },
      {
        "command": "localians.openDashboard",
        "title": "Open Dashboard",
        "category": "Localians",
        "icon": "$(globe)"
      },
      {
        "command": "localians.refresh",
        "title": "Refresh",
        "category": "Localians",
        "icon": "$(refresh)"
      },
      {
        "command": "localians.login",
        "title": "Sign In",
        "category": "Localians",
        "icon": "$(sign-in)"
      },
      {
        "command": "localians.logout",
        "title": "Sign Out",
        "category": "Localians",
        "icon": "$(sign-out)"
      },
      {
        "command": "localians.switchAccount",
        "title": "Switch Account",
        "category": "Localians"
      },
      {
        "command": "localians.help",
        "title": "Documentation",
        "category": "Localians",
        "icon": "$(question)"
      },
      {
        "command": "localians.showLog",
        "title": "Show Log",
        "category": "Localians"
      },
      {
        "command": "localians.gettingStarted",
        "title": "Getting Started",
        "category": "Localians",
        "icon": "$(book)"
      }
    ],
    "menus": {
      "view/title": [
        {
          "command": "localians.refresh",
          "when": "view == localians.panel && localians.signedIn",
          "group": "navigation@1"
        },
        {
          "command": "localians.gettingStarted",
          "when": "view == localians.panel",
          "group": "navigation@2"
        },
        {
          "command": "localians.openDashboard",
          "when": "view == localians.panel && localians.signedIn",
          "group": "1_links@1"
        },
        {
          "command": "localians.help",
          "when": "view == localians.panel",
          "group": "1_links@2"
        },
        {
          "command": "localians.switchAccount",
          "when": "view == localians.panel && localians.signedIn",
          "group": "2_account@1"
        },
        {
          "command": "localians.logout",
          "when": "view == localians.panel && localians.signedIn",
          "group": "2_account@2"
        }
      ],
      "commandPalette": [
        {
          "command": "localians.share",
          "when": "localians.signedIn"
        },
        {
          "command": "localians.stop",
          "when": "localians.sharing"
        },
        {
          "command": "localians.copyLink",
          "when": "localians.sharing"
        },
        {
          "command": "localians.openPreview",
          "when": "localians.sharing"
        },
        {
          "command": "localians.protect",
          "when": "localians.sharing"
        },
        {
          "command": "localians.reconnect",
          "when": "false"
        },
        {
          "command": "localians.refresh",
          "when": "localians.signedIn"
        },
        {
          "command": "localians.logout",
          "when": "localians.signedIn"
        },
        {
          "command": "localians.switchAccount",
          "when": "localians.signedIn"
        },
        {
          "command": "localians.login",
          "when": "!localians.signedIn"
        }
      ]
    },
    "configuration": {
      "title": "Localians",
      "properties": {
        "localians.serverUrl": {
          "type": "string",
          "default": "https://localians.com",
          "scope": "application",
          "markdownDescription": "Localians server. Leave as `https://localians.com` unless you run your own. Must be `https://` (plain `http://` only for `localhost`). Changing it signs you out."
        },
        "localians.extraPorts": {
          "type": "array",
          "items": {
            "type": "integer",
            "minimum": 1,
            "maximum": 65535
          },
          "maxItems": 20,
          "default": [],
          "scope": "application",
          "markdownDescription": "Extra local ports to look for running apps (besides common ones like 3000, 4200, 5173 and 8000). Only `localhost` is ever checked."
        },
        "localians.hostHeader": {
          "type": "string",
          "enum": [
            "rewrite",
            "preserve"
          ],
          "enumDescriptions": [
            "Send `Host: localhost:<port>` (what most dev servers expect)",
            "Forward the public preview host"
          ],
          "default": "rewrite",
          "scope": "resource",
          "description": "Host header your app receives for preview requests."
        },
        "localians.verboseLog": {
          "type": "boolean",
          "default": false,
          "description": "Log every forwarded request (method, path, status) to the Localians output. Never logs tokens or passwords."
        }
      }
    },
    "walkthroughs": [
      {
        "id": "start",
        "title": "Get started with Localians",
        "description": "Share your localhost apps securely in seconds: sign in, run your app, share, copy the link.",
        "steps": [
          {
            "id": "signIn",
            "title": "Sign in",
            "description": "Connect your Localians account. Your browser opens once to approve VS Code.\n[Sign In to Localians](command:localians.login)",
            "media": {
              "markdown": "media/walkthrough/sign-in.md"
            },
            "completionEvents": [
              "onContext:localians.signedIn"
            ]
          },
          {
            "id": "runApp",
            "title": "Run your app",
            "description": "Start your development server normally, for example `npm run dev`.\n[Open a Terminal](command:workbench.action.terminal.new)",
            "media": {
              "markdown": "media/walkthrough/run-app.md"
            },
            "completionEvents": [
              "onCommand:workbench.action.terminal.new"
            ]
          },
          {
            "id": "share",
            "title": "Share",
            "description": "Choose your running port in the Localians sidebar and click Share App.\n[Open Localians](command:localians.focus)",
            "media": {
              "markdown": "media/walkthrough/share.md"
            },
            "completionEvents": [
              "onContext:localians.sharing"
            ]
          },
          {
            "id": "copyLink",
            "title": "Copy the link",
            "description": "Send the HTTPS preview link to anyone.\n[Copy Preview Link](command:localians.copyLink)",
            "media": {
              "markdown": "media/walkthrough/copy-link.md"
            },
            "completionEvents": [
              "onCommand:localians.copyLink"
            ]
          }
        ]
      }
    ]
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "build:release": "node scripts/build.mjs --production",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "package": "node scripts/package.mjs"
  },
  "devDependencies": {
    "@types/node": "^20.19.0",
    "@types/vscode": "~1.90.0",
    "@vscode/vsce": "^3.6.0",
    "esbuild": "^0.25.0",
    "typescript": "^5.8.0"
  }
}
