// Localians — database schema
//
// Auth tables (User, Session, Account, Verification, RateLimit) follow the
// Better Auth core schema. Product tables hang off Workspace so later phases
// (tunnels, preview URLs, access policies, analytics, CLI tokens, billing)
// can attach by workspaceId / projectId without reshaping existing data.

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ---------------------------------------------------------------------------
// Authentication (Better Auth)
// ---------------------------------------------------------------------------

model User {
  id            String   @id
  name          String
  email         String   @unique
  emailVerified Boolean  @default(false)
  image         String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  /// Dashboard theme. Managed by Localians, not by Better Auth.
  themePreference ThemePreference @default(DARK)
  /// Set once the user finishes (or skips) onboarding.
  onboardedAt     DateTime?

  /// Permanent public ID shown to people (support, admin), e.g. LOC-000001. Assigned by a database sequence; never
  /// the internal auth ID.
  publicId    String     @unique @default(dbgenerated("('LOC-'::text || lpad((nextval('users_public_id_seq'::regclass))::text, 6, '0'::text))"))
  /// Unique, lowercase handle (3–24 chars: a-z, 0-9, _). Null for accounts from before usernames (asked on next visit).
  username    String?    @unique
  status      UserStatus @default(ACTIVE)
  /// ADMIN may use /admin. Never settable by clients; created by scripts/create-admin.ts.
  role        UserRole   @default(USER)
  suspendedAt DateTime?
  /// Accounts are deactivated and anonymised, not deleted, so payment and audit records stay intact.
  deletedAt   DateTime?

  sessions        Session[]
  accounts        Account[]
  ownedWorkspaces Workspace[]       @relation("WorkspaceOwner")
  memberships     WorkspaceMember[]
  cliCredentials  CliCredential[]
  shareSetups     ShareSetup[]
  tunnelSessions  TunnelSession[]
  upgradeRequests UpgradeRequest[]

  @@map("users")
}

model Session {
  id        String   @id
  expiresAt DateTime
  token     String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  ipAddress String?
  userAgent String?
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("sessions")
}

model Account {
  id                    String    @id
  accountId             String
  providerId            String
  userId                String
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  /// Password hash (scrypt) for email/password accounts only.
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  @@unique([providerId, accountId])
  @@index([userId])
  @@map("accounts")
}

model Verification {
  id         String   @id
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([identifier])
  @@map("verifications")
}

/// Persistent rate-limit counters for auth endpoints (shared across instances).
model RateLimit {
  id          String @id
  key         String @unique
  count       Int
  lastRequest BigInt

  @@map("rate_limits")
}

// ---------------------------------------------------------------------------
// Workspaces
// ---------------------------------------------------------------------------

model Workspace {
  id        String   @id @default(cuid())
  name      String
  slug      String   @unique
  /// The owner cannot be deleted while they own a workspace (ownership
  /// transfer arrives with team features in Stage 2).
  ownerId   String
  owner     User     @relation("WorkspaceOwner", fields: [ownerId], references: [id], onDelete: Restrict)
  /// Uploaded workspace avatar (media_files row; the image itself lives in the upload directory, not the database).
  avatarId  String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  members         WorkspaceMember[]
  projects        Project[]
  cliCredentials  CliCredential[]
  tunnelEvents    TunnelEvent[]
  shareSetups     ShareSetup[]
  tunnelMetrics   TunnelMetric[]
  previewNames    PreviewName[]
  freeGrants      FreePreviewGrant[]
  upgradeRequests UpgradeRequest[]

  @@index([ownerId])
  @@map("workspaces")
}

model WorkspaceMember {
  id          String        @id @default(cuid())
  workspaceId String
  workspace   Workspace     @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  userId      String
  user        User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  role        WorkspaceRole @default(MEMBER)
  createdAt   DateTime      @default(now())

  @@unique([workspaceId, userId])
  @@index([userId])
  @@map("workspace_members")
}

// ---------------------------------------------------------------------------
// Projects
// ---------------------------------------------------------------------------

model Project {
  id          String        @id @default(cuid())
  workspaceId String
  workspace   Workspace     @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  name        String
  slug        String
  description String?
  framework   Framework?
  defaultPort Int?
  /// Lifecycle state only — says nothing about whether a tunnel is connected.
  status      ProjectStatus @default(ACTIVE)
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt
  archivedAt  DateTime?

  /// Who may open this project's preview links (Phase 5). Enforced by the gateway.
  accessMode         PreviewAccess @default(PUBLIC)
  /// scrypt hash of the preview password (never the password itself).
  accessPasswordHash String?
  /// Bumped on every password change or "sign out all visitors": older visitor access cookies stop working.
  accessVersion      Int           @default(1)
  /// How long a visitor stays signed in after entering the password.
  accessTtlMinutes   Int           @default(1440)
  accessUpdatedAt    DateTime?

  tunnelSessions  TunnelSession[]
  shareSetups     ShareSetup[]
  previewName     PreviewName?
  freeGrant       FreePreviewGrant?
  passes          PreviewPass[]
  upgradeRequests UpgradeRequest[]

  @@unique([workspaceId, slug])
  @@index([workspaceId, status, updatedAt])
  @@map("projects")
}

// ---------------------------------------------------------------------------
// CLI access (Phase 3)
// ---------------------------------------------------------------------------

/// A revocable, workspace-scoped token issued to the Localians CLI. Only a
/// SHA-256 hash of the token is stored; the plaintext is shown to the CLI once.
model CliCredential {
  id          String    @id @default(cuid())
  userId      String
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  workspaceId String
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  /// Human label, e.g. "CLI on DESKTOP-42 (win32)".
  name        String
  tokenHash   String    @unique
  /// First characters of the token, for recognising it in the dashboard.
  tokenPrefix String
  createdAt   DateTime  @default(now())
  expiresAt   DateTime
  revokedAt   DateTime?
  lastUsedAt  DateTime?

  tunnelSessions TunnelSession[]

  @@index([userId, revokedAt])
  @@map("cli_credentials")
}

/// OAuth 2.0 Device Authorization Grant (RFC 8628) requests from the CLI.
model DeviceAuthorization {
  id             String           @id @default(cuid())
  /// SHA-256 of the device_code held by the CLI.
  deviceCodeHash String           @unique
  /// Short code the user confirms in the browser (stored normalised, e.g. "WDJBMJHT").
  userCode       String           @unique
  clientName     String
  status         DeviceAuthStatus @default(PENDING)
  userId         String?
  workspaceId    String?
  createdAt      DateTime         @default(now())
  expiresAt      DateTime
  decidedAt      DateTime?
  lastPolledAt   DateTime?

  @@index([expiresAt])
  @@map("device_authorizations")
}

// ---------------------------------------------------------------------------
// Tunnels (Phase 3)
// ---------------------------------------------------------------------------

/// One `localians share` run. Live sockets stay in gateway memory; this row
/// holds the durable metadata (never request or response contents).
model TunnelSession {
  id                  String         @id @default(cuid())
  projectId           String
  project             Project        @relation(fields: [projectId], references: [id], onDelete: Cascade)
  userId              String
  user                User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  credentialId        String?
  credential          CliCredential? @relation(fields: [credentialId], references: [id], onDelete: SetNull)
  /// Random preview label (`<label>.<preview domain>`). Unique forever, so an
  /// ended session's URL can never be claimed by anyone else.
  hostname            String         @unique
  /// Custom name this session is served on instead of `hostname` (Preview Pass), or null for the random URL.
  /// Several sessions over time share a name; at most one of them is active.
  customName          String?
  localPort           Int
  /// Length chosen when it started (null for sessions from before timers). expiresAt is the authority.
  durationMinutes     Int?
  /// FREE (the project's free preview) or PASS (a 7-Day Pass); null for sessions from before plans.
  planTier            String?
  /// Runs until the free window / pass ends (no shorter auto-stop chosen): extended when a pass is renewed.
  untilPlanEnd        Boolean        @default(false)
  status              TunnelStatus   @default(CONNECTING)
  createdAt           DateTime       @default(now())
  updatedAt           DateTime       @default(now()) @updatedAt
  connectedAt         DateTime?
  lastHeartbeatAt     DateTime?
  disconnectedAt      DateTime?
  /// Last traffic or lifecycle change; drives "latest activity" sorting.
  lastActivityAt      DateTime       @default(now())
  expiresAt           DateTime
  endReason           String?
  gatewayId           String?
  /// Gateway connection currently carrying this session (see TunnelConnection).
  currentConnectionId String?
  /// Lifetime transfer totals: HTTP body + WebSocket payload bytes (README "Traffic accounting").
  bytesIn             BigInt         @default(0)
  bytesOut            BigInt         @default(0)
  requestCount        Int            @default(0)

  connections TunnelConnection[]
  events      TunnelEvent[]
  metrics     TunnelMetric[]

  @@index([projectId, status])
  @@index([userId, status])
  @@index([status, lastHeartbeatAt])
  @@index([projectId, lastActivityAt])
  @@index([customName, status])
  @@map("tunnel_sessions")
}

/// One physical CLI ↔ gateway connection of a session (a reconnect is a new row).
/// The gateway reports *cumulative* counters per connection; keeping the last
/// values seen lets the control plane apply only the increase, so retried or
/// redelivered reports are never counted twice.
model TunnelConnection {
  /// Random id the gateway generates when it accepts the connection.
  id             String        @id
  sessionId      String
  session        TunnelSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  gatewayId      String
  connectedAt    DateTime      @default(now())
  disconnectedAt DateTime?
  bytesIn        BigInt        @default(0)
  bytesOut       BigInt        @default(0)
  requests       Int           @default(0)

  @@index([sessionId])
  @@map("tunnel_connections")
}

/// Recorded lifecycle transitions of a session (never request data).
model TunnelEvent {
  id          String          @id @default(cuid())
  sessionId   String
  session     TunnelSession   @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  workspaceId String
  workspace   Workspace       @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  type        TunnelEventType
  detail      String?
  createdAt   DateTime        @default(now())

  @@index([sessionId, createdAt])
  @@index([workspaceId, createdAt])
  @@map("tunnel_events")
}

/// Traffic per session per UTC hour, written as metering arrives. Supports
/// time-ranged analytics without storing per-request rows.
model TunnelMetric {
  sessionId   String
  session     TunnelSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  /// Denormalised from the session's project for range queries.
  projectId   String
  workspaceId String
  workspace   Workspace     @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  bucketStart DateTime
  requests    Int           @default(0)
  bytesIn     BigInt        @default(0)
  bytesOut    BigInt        @default(0)

  @@id([sessionId, bucketStart])
  @@index([workspaceId, bucketStart])
  @@index([projectId, bucketStart])
  @@map("tunnel_metrics")
}

// ---------------------------------------------------------------------------
// Enums
// ---------------------------------------------------------------------------

enum WorkspaceRole {
  OWNER
  MEMBER
}

enum ProjectStatus {
  ACTIVE
  ARCHIVED
}

enum Framework {
  NEXTJS
  REACT_VITE
  VUE
  ANGULAR
  NODEJS
  OTHER
}

enum ThemePreference {
  DARK
  LIGHT
  SYSTEM
}

enum DeviceAuthStatus {
  PENDING
  APPROVED
  DENIED
  CONSUMED
}

enum TunnelStatus {
  CONNECTING
  CONNECTED
  RECONNECTING
  DISCONNECTED
  EXPIRED
  REVOKED
}

enum TunnelEventType {
  CREATED
  CONNECTED
  RECONNECTED
  CONNECTION_LOST
  STOPPED_BY_CLI
  STOPPED_FROM_DASHBOARD
  REVOKED
  EXPIRED
  PROTECTION_CHANGED
  VISITORS_SIGNED_OUT
  QUOTA_EXCEEDED
}

enum PreviewAccess {
  PUBLIC
  PASSWORD
}

// ---------------------------------------------------------------------------
// Phase 5
// ---------------------------------------------------------------------------

/// Context prepared in the Share App wizard (port, project, protection) that the CLI redeems
/// once with `localians share <port> --setup <code>`. Only a hash of the code is stored; it is
/// short-lived, single-use, and only redeemable by a CLI login of the same user and workspace.
model ShareSetup {
  id                 String         @id @default(cuid())
  codeHash           String         @unique
  userId             String
  user               User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  workspaceId        String
  workspace          Workspace      @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  /// Existing project to share under, or null to create `newProjectName`.
  projectId          String?
  project            Project?       @relation(fields: [projectId], references: [id], onDelete: Cascade)
  newProjectName     String?
  port               Int?
  /// "random" or "custom" preview URL chosen in the wizard (null = the project's default).
  urlMode            String?
  /// Session length chosen in the wizard (checked against the plan again when the CLI starts the session).
  durationMinutes    Int?
  accessMode         PreviewAccess?
  accessPasswordHash String?
  createdAt          DateTime       @default(now())
  updatedAt          DateTime       @updatedAt
  expiresAt          DateTime
  usedAt             DateTime?

  @@index([userId, createdAt])
  @@index([expiresAt])
  @@map("share_setups")
}

/// Fixed-window counters shared by every web instance (replaces the per-process limiter).
model RateLimitWindow {
  key         String
  windowStart DateTime
  count       Int      @default(0)
  expiresAt   DateTime

  @@id([key, windowStart])
  @@index([expiresAt])
  @@map("rate_limit_windows")
}

// ---------------------------------------------------------------------------
// Custom preview URLs (Preview Pass)
// ---------------------------------------------------------------------------

/// A reserved custom preview name (`<name>.<preview domain>`), owned by a workspace and bound to one project,
/// independently of tunnel sessions. One row per name, forever: ownership moves only through explicit, audited
/// transitions (hold → active → released → quarantine → claimable), so a link can't silently change hands.
model PreviewName {
  id            String            @id @default(cuid())
  /// Lowercase, 3–32 chars of a-z 0-9 and single hyphens (see src/lib/preview-names.ts).
  name          String            @unique
  workspaceId   String
  workspace     Workspace         @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  /// The project it routes to. Unique: a project has at most one custom name.
  projectId     String?           @unique
  project       Project?          @relation(fields: [projectId], references: [id], onDelete: SetNull)
  status        PreviewNameStatus
  /// HELD: reserved for this workspace's checkout until then (at most 15 minutes).
  heldUntil     DateTime?
  claimedAt     DateTime?
  releasedAt    DateTime?
  /// RELEASED: nobody else may claim it before this (the previous owner may reclaim it any time).
  availableAt   DateTime?
  releaseReason String?
  createdById   String?
  createdAt     DateTime          @default(now())
  updatedAt     DateTime          @updatedAt

  @@index([workspaceId, status])
  @@index([status, heldUntil])
  @@map("preview_names")
}

enum PreviewNameStatus {
  HELD
  ACTIVE
  RELEASED
}

/// Append-only record of security- and money-relevant changes (custom names, entitlements, payments, admin actions).
/// Details are short structured facts — never passwords, tokens, keys or full request data.
model AuditLog {
  id          String   @id @default(cuid())
  workspaceId String?
  /// USER (a signed-in member), ADMIN (an operator), SYSTEM (sweeps, reconciliation).
  actorType   String
  actorId     String?
  action      String
  subjectType String
  subjectId   String
  detail      Json?
  createdAt   DateTime @default(now())

  @@index([workspaceId, createdAt])
  @@index([subjectType, subjectId, createdAt])
  @@map("audit_logs")
}

// ---------------------------------------------------------------------------
// Preview plans: one free 24-hour preview per project, then 7-Day Passes ($5)
// ---------------------------------------------------------------------------

/// A project's one free preview: a 24-hour window that starts with its first share. Shares inside the window are
/// allowed (restarts, reconnects, another port) but never outlive it. Kept when the project is deleted (projectId set
/// to null) so deleting and re-creating projects doesn't reset the per-workspace / per-user free allowance.
model FreePreviewGrant {
  id          String    @id @default(cuid())
  projectId   String?   @unique
  project     Project?  @relation(fields: [projectId], references: [id], onDelete: SetNull)
  workspaceId String
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  /// Who started it (no foreign key: the record must outlive the user for abuse limits).
  userId      String
  startedAt   DateTime  @default(now())
  endsAt      DateTime

  @@index([workspaceId, startedAt])
  @@index([userId, startedAt])
  @@map("free_preview_grants")
}

/// 7 days of preview access for one project (plus its custom URL). Non-recurring: a renewal is a new row that starts
/// when the current one ends. Never created from a client claim — only by verified payment or an operator.
model PreviewPass {
  id           String          @id @default(cuid())
  projectId    String
  project      Project         @relation(fields: [projectId], references: [id], onDelete: Cascade)
  workspaceId  String
  startsAt     DateTime
  endsAt       DateTime
  status       PassStatus      @default(ACTIVE)
  source       PassSource
  /// The approved upgrade request that created it (one pass per request, enforced by the database).
  requestId    String?         @unique
  request      UpgradeRequest? @relation(fields: [requestId], references: [id], onDelete: SetNull)
  createdById  String?
  /// Admin grants from Manage Plan (no payment): why, the admin's explanation, and the click's idempotency key.
  grantReason  PassGrantReason?
  grantNote    String?
  grantKey     String?         @unique
  revokedAt    DateTime?
  revokeReason String?
  createdAt    DateTime        @default(now())

  @@index([projectId, status, endsAt])
  @@map("preview_passes")
}

enum PassStatus {
  ACTIVE
  REVOKED
}

enum PassSource {
  PAYMENT
  ADMIN
}

enum PassGrantReason {
  COMPLIMENTARY
  SUPPORT_ADJUSTMENT
}

enum UserStatus {
  ACTIVE
  SUSPENDED
  DELETED
}

enum UserRole {
  USER
  ADMIN
}

/// A request to buy a 7-Day Pass for one project (manual USDT payment, approved by an administrator after verifying
/// the transfer on BNB Smart Chain). Nothing is activated by the request or a submitted hash alone.
model UpgradeRequest {
  id            String        @id @default(cuid())
  /// Public order ID shown to the customer and in emails, e.g. ORD-7K2M9QXA.
  orderId       String        @unique
  userId        String
  user          User          @relation(fields: [userId], references: [id], onDelete: Restrict)
  workspaceId   String
  workspace     Workspace     @relation(fields: [workspaceId], references: [id], onDelete: Restrict)
  /// Kept if the project is deleted (money records outlive projects); projectName is a snapshot.
  projectId     String?
  project       Project?      @relation(fields: [projectId], references: [id], onDelete: SetNull)
  projectName   String
  product       String
  /// 6-decimal micro-units of USDT (5 USDT = 5000000). Snapshot of the price when the order was created.
  amountMicros  BigInt
  /// Snapshot of the pass length (days) when the order was created; the pass granted on approval uses it.
  passDays      Int           @default(7)
  currency      String
  network       String
  recipient     String
  /// Snapshot of the uploaded payment QR (media_files id) shown for this order; it was verified to encode `recipient`.
  /// Null: the QR is generated from `recipient`. Later wallet/QR changes never touch an existing order.
  qrImageId     String?
  /// Custom URL the customer chose at checkout (applied when the pass activates, if still free).
  requestedName String?
  status        UpgradeStatus @default(PENDING)
  /// Lowercase 0x-prefixed transaction hash; unique across all requests (a transfer pays for one request only).
  txHash        String?       @unique
  txSubmittedAt DateTime?
  /// Last on-chain check (token, recipient, amount, success, confirmations, time), recorded by the server.
  verification  Json?
  verifiedAt    DateTime?
  verifiedOk    Boolean       @default(false)
  reviewedById  String?
  reviewedAt    DateTime?
  reviewNote    String?
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  pass PreviewPass?

  @@index([status, createdAt])
  @@index([userId, createdAt])
  @@index([projectId])
  @@map("upgrade_requests")
}

enum UpgradeStatus {
  PENDING
  UNDER_REVIEW
  APPROVED
  REJECTED
  CANCELLED
}

/// Admin-managed payment configuration: one row (id = 1). The effective "payments on" state is this row's `enabled`,
/// unless PAYMENTS_EMERGENCY_DISABLE=on forces it off. Every change is written to audit_logs (old and new values).
model PaymentSetting {
  id          Int      @id @default(1)
  enabled     Boolean  @default(false)
  /// Lowercase 0x address that new orders pay to (snapshotted on each order as upgrade_requests.recipient).
  recipient   String
  /// Uploaded QR image (media_files id), accepted only when it decodes to `recipient`; null = generated QR.
  qrImageId   String?
  /// Price of a Preview Pass for NEW orders, in USDT micro-units (6 decimals). USD prices are charged 1:1 in USDT.
  priceMicros BigInt   @default(5000000)
  /// Length of a Preview Pass for NEW orders, in days.
  passDays    Int      @default(7)
  /// When the price or length last changed (null: never changed from the defaults).
  pricingUpdatedAt DateTime?
  updatedAt   DateTime @updatedAt
  updatedById String?

  @@map("payment_settings")
}

/// An uploaded image (payment QR or workspace avatar). Only metadata is stored here: the file is in the persistent
/// upload directory (LOCALIANS_UPLOAD_DIR) under `storageKey`, a server-generated name. Rows are never reused.
model MediaFile {
  id          String   @id @default(cuid())
  /// "payment_qr" | "workspace_avatar"
  kind        String
  /// Workspace that owns a workspace avatar; null for payment QR images.
  workspaceId String?
  storageKey  String   @unique
  contentType String
  bytes       Int
  width       Int
  height      Int
  sha256      String
  /// Decoded QR content (payment QR images only), checked against the wallet address.
  qrData      String?
  createdById String?
  createdAt   DateTime @default(now())

  @@index([kind, workspaceId])
  @@map("media_files")
}
