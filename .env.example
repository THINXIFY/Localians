# ---------------------------------------------------------------------------
# Localians — environment variables
# Copy to `.env` for local development. Never commit real secrets.
# ---------------------------------------------------------------------------

# Public base URL of this app (used for auth callbacks, emails, metadata).
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# PostgreSQL connection string.
# `npm run db:start` runs a project-local PostgreSQL on port 5433 with these credentials.
# Point this at any managed PostgreSQL (Neon, Supabase, RDS, ...) in other environments.
DATABASE_URL="postgresql://localians:localians@localhost:5433/localians"

# Better Auth
# Generate with: npx @better-auth/cli secret   (or: openssl rand -base64 32)
BETTER_AUTH_SECRET="replace-with-a-long-random-secret"
BETTER_AUTH_URL="http://localhost:3000"

# GitHub OAuth (optional). Create an OAuth app at https://github.com/settings/developers
# Authorization callback URL: <BETTER_AUTH_URL>/api/auth/callback/github
GITHUB_CLIENT_ID=""
GITHUB_CLIENT_SECRET=""

# Transactional email
#   resend  — real delivery through Resend (requires RESEND_API_KEY and EMAIL_FROM)
#   console — DEVELOPMENT ONLY: prints emails (including links) to the server terminal
#   outbox  — TEST ONLY: writes emails to .localians-dev/outbox for automated tests
# console/outbox are refused when NODE_ENV=production.
EMAIL_TRANSPORT="console"
RESEND_API_KEY=""
EMAIL_FROM="Localians <auth@localians.com>"

# ---------------------------------------------------------------------------
# Tunnels (Phase 3). Shared by the web app (control plane) and the gateway.
# ---------------------------------------------------------------------------
# Previews are served at https://<random-label>.<TUNNEL_PREVIEW_DOMAIN>.
# Production (localians.com): a wildcard DNS record (*.preview.localians.com) pointing at the gateway,
# plus a matching wildcard TLS certificate. Locally, *.localhost resolves in browsers.
TUNNEL_PREVIEW_DOMAIN="preview.localhost"
TUNNEL_PUBLIC_SCHEME="https"
# Only needed when the gateway isn't on the default port for the scheme.
TUNNEL_PUBLIC_PORT="8443"
# Where the CLI connects (the gateway's tunnel host).
TUNNEL_GATEWAY_URL="https://127.0.0.1:8443"
# HS256 key the web app signs connect tokens with and the gateway verifies (>= 32 chars).
TUNNEL_TOKEN_SECRET="replace-with-32+-random-characters"
# Bearer secret the gateway uses for /api/internal/gateway/events (>= 32 chars).
GATEWAY_API_SECRET="replace-with-a-different-32+-random-characters"
# Where the web app reaches the gateway control API (the gateway admin listener).
# Without it, "Stop preview" still revokes the session, and the gateway stops routing it at its
# next heartbeat (~20 s) instead of immediately.
GATEWAY_CONTROL_URL="http://127.0.0.1:8444"
# Optional: device-login requests per IP per minute (default 10).
# CLI_DEVICE_RATE_LIMIT="10"

# --- Gateway process only (node --env-file=.env tunnel/gateway/dist/gateway.js) ---
CONTROL_PLANE_URL="http://localhost:3001"
GATEWAY_PORT="8443"
GATEWAY_TUNNEL_HOST="127.0.0.1"
# Local test certificates from `npm run tunnel:certs`. Use a real wildcard cert in production,
# or terminate TLS at a proxy and set GATEWAY_BEHIND_TLS_PROXY=1 instead.
GATEWAY_TLS_CERT_FILE=".localians-dev/certs/gateway.crt"
GATEWAY_TLS_KEY_FILE=".localians-dev/certs/gateway.key"
# Private admin listener: health, metrics and the control API the web app uses to list and
# stop tunnels (bearer GATEWAY_API_SECRET). Keep it on loopback or a private network.
GATEWAY_ADMIN_PORT="8444"
# GATEWAY_ADMIN_HOST="127.0.0.1"
# Exact IPs of reverse proxies whose X-Forwarded-For the gateway may trust.
# GATEWAY_TRUSTED_PROXIES=""

# --- CLI distribution ---
# Server URL baked into the CLI by `npm run tunnel:build` (defaults to BETTER_AUTH_URL).
# LOCALIANS_DEFAULT_API_URL="https://localians.com"   (npm run cli:release uses this by default)
# Set to 1 only after the `localians` npm package is published: the dashboard then shows `npx localians` commands.
# LOCALIANS_CLI_PUBLISHED="0"

# --- Phase 5: quotas, monitoring, multiple gateways ---
# QUOTA_ACTIVE_PREVIEWS_PER_USER="5"
# QUOTA_MAX_SHARE_HOURS="24"
# QUOTA_SESSIONS_PER_DAY="100"
# QUOTA_DAILY_BANDWIDTH_MB="10240"
# Forward server errors (JSON) to an error monitor's webhook.
# ERROR_WEBHOOK_URL=""
# Several gateways: give each a stable GATEWAY_ID, then list their control URLs here (instead of GATEWAY_CONTROL_URL).
# GATEWAY_CONTROL_URLS="gw-eu=http://10.0.0.5:8444,gw-us=http://10.0.1.5:8444"
# GATEWAY_ID="gw-eu"

# --- Preview plans & payments ---
# QUOTA_FREE_PREVIEWS_PER_30_DAYS="3"
# PREVIEW_CUSTOM_NAMES="on"          # local gateway supports custom URLs
# PAYMENTS_ENABLED="on"              # take 7-Day Pass requests locally (manual review in /admin/payments)
# ADMIN_NOTIFY_EMAIL="you@example.com"
# BSC_RPC_URL="https://bsc-dataseed.bnbchain.org"
