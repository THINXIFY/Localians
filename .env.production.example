# =============================================================================
# Localians — production environment (placeholders only; never commit real values)
#
# The server uses TWO files, readable only by root and the `localians` group (chmod 640):
#   /etc/localians/web.env      → section A (web app, Next.js on 127.0.0.1:4000)
#   /etc/localians/gateway.env  → section B (tunnel gateway on 127.0.0.1:4100, admin 127.0.0.1:4101)
# Validate before deploying (deploy.sh does this automatically):
#   node --env-file=/etc/localians/web.env     scripts/check-production-env.mjs web
#   node --env-file=/etc/localians/gateway.env scripts/check-production-env.mjs gateway
#
# Generate each secret separately:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
#
# Production hostnames (enforced by check-production-env.mjs; LOCALIANS_CUSTOM_HOSTS=1 for staging):
#   localians.com              website, dashboard, auth, API, CLI authorization (/cli/activate)
#   tunnel.localians.com       where the CLI connects (must NOT be under the preview domain)
#   *.preview.localians.com    preview links. Beta: same registrable domain as the app — see
#                              deploy/README.md §8 for the cookie and same-site assessment.
# =============================================================================

# ----------------------------------------------------------------------------- A. web.env
NODE_ENV="production"
# Turns off every development/test fallback (console email, disabled auth rate limits).
LOCALIANS_DEPLOYMENT="production"
# Informational: the systemd unit runs `next start --port 4000 --hostname 127.0.0.1`.
PORT="4000"

# Public URL of the web app (no trailing slash). Session cookies are Secure because it's https.
NEXT_PUBLIC_SITE_URL="https://localians.com"
BETTER_AUTH_URL="https://localians.com"
BETTER_AUTH_SECRET="replace-with-32+-random-characters-A"

# Written by provision.sh (local PostgreSQL, random password). Port 5432 is never public.
DATABASE_URL="postgresql://localians:REPLACE_WITH_GENERATED_PASSWORD@127.0.0.1:5432/localians"

# GitHub sign-in (optional). OAuth app callback: https://localians.com/api/auth/callback/github
GITHUB_CLIENT_ID=""
GITHUB_CLIENT_SECRET=""

# Transactional email via Resend (verification, password reset, notices). Required in production.
EMAIL_TRANSPORT="resend"
RESEND_API_KEY="re_replace_me"
EMAIL_FROM="Localians <auth@localians.com>"

# Tunnels
TUNNEL_PREVIEW_DOMAIN="preview.localians.com"
TUNNEL_PUBLIC_SCHEME="https"
# Leave TUNNEL_PUBLIC_PORT unset: previews are served on 443.
TUNNEL_GATEWAY_URL="https://tunnel.localians.com"
TUNNEL_TOKEN_SECRET="replace-with-32+-random-characters-B"
GATEWAY_API_SECRET="replace-with-32+-random-characters-C"
# The gateway's private control API (loopback only).
GATEWAY_CONTROL_URL="http://127.0.0.1:4101"

# Set to 1 only after the `localians` npm package is published (the dashboard then shows `npx localians`).
LOCALIANS_CLI_PUBLISHED="0"

# Usage limits
QUOTA_ACTIVE_PREVIEWS_PER_USER="5"
QUOTA_MAX_SHARE_HOURS="24"
QUOTA_SESSIONS_PER_DAY="100"
QUOTA_DAILY_BANDWIDTH_MB="10240"
CLI_DEVICE_RATE_LIMIT="10"

# Error monitoring: server errors are logged as JSON to the journal; optionally also POSTed here.
ERROR_WEBHOOK_URL=""

# ----------------------------------------------------------------------------- B. gateway.env
# NODE_ENV="production"
# LOCALIANS_DEPLOYMENT="production"
# GATEWAY_ID="gw-vps-1"                  # stable across restarts
# GATEWAY_HOST="127.0.0.1"               # only Nginx reaches it
# GATEWAY_PORT="4100"
# GATEWAY_ADMIN_HOST="127.0.0.1"
# GATEWAY_ADMIN_PORT="4101"              # /healthz, /readyz, /metrics + control API (bearer secret)
# GATEWAY_BEHIND_TLS_PROXY="1"           # Nginx terminates TLS; public scheme is https
# GATEWAY_TRUSTED_PROXIES="127.0.0.1"    # trust X-Forwarded-For only from Nginx
# GATEWAY_TUNNEL_HOST="tunnel.localians.com"
# TUNNEL_PREVIEW_DOMAIN="preview.localians.com"
# TUNNEL_TOKEN_SECRET="(same value as in web.env)"
# GATEWAY_API_SECRET="(same value as in web.env)"
# CONTROL_PLANE_URL="http://127.0.0.1:4000"   # the web app, directly (not through Nginx)
# Optional limits (defaults in tunnel/gateway/config.ts):
# GATEWAY_MAX_TUNNELS="1000"
# GATEWAY_MAX_STREAMS_PER_TUNNEL="100"
# GATEWAY_RPS_PER_TUNNEL="100"
# GATEWAY_RPS_PER_IP="50"
# GATEWAY_MAX_REQUEST_BODY_BYTES="26214400"
# GATEWAY_MAX_RESPONSE_BYTES="536870912"
